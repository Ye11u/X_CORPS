       <string notr="true">QProgressBar {
    border: 2px solid #185a9d;
    border-radius: 8px;
    background: #e0f7f5;
    text-align: center;
    color: black;
}
QProgressBar::chunk {
    border-radius: 8px;
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #6aa7c9,   /* 위쪽 조금 더 밝은 블루 */
        stop:1 #4480a8    /* 아래쪽 메인 블루 */
    );
}
</string>
